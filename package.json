{
  "name": "geoui-intent-protocol",
  "private": true,
  "type": "module",
  "description": "npm workspaces for the GeoUI Intent Protocol: the @geoui/react SDK and the MapLibre demo app",
  "workspaces": [
    "sdk/geoui-react",
    "demo/maplibre"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "gen:types": "npm run gen:types --workspace @geoui/react",
    "dev": "npm run dev --workspace geoui-maplibre-demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0"
  }
}
