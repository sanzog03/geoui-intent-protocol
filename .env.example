# --- demo (geoui-demos) ---
OPENAI_API_KEY=
# Set automatically by demo/start.sh; override only when driving your own Chromium
PLAYWRIGHT_CDP_ENDPOINT=http://localhost:9222
# --- MapLibre demo (package maplibre): the page that exposes window.geoui; opened in a new tab when none is found ---
GEOUI_APP_URL=http://localhost:5173

# --- MCP server groups of the worldview-assistant plugin (demo/worldview/agents/artifact/worldview/geoui/akd-plugins) ---
# Each key unlocks one group; servers whose key is unset are skipped with a warning.
# Auth for the IESO validation MCP (search_worldview_layers, validate_temporal_coverage)
VECTOR_DB_TOOL_KEY=
# FastMCP token for the shared IESO tools group (UMM-Vis lookup, Earthdata-search landing page, PDF parser)
IESO_MCP_KEY=
# FastMCP token for the Science Discovery Engine fallback search
SDE_MCP_KEY=
# FastMCP token for the EONET natural-event search
EONET_TOKEN=

# --- optional overrides ---
# WORLDVIEW_PLUGIN_DIR=/path/to/akd-plugins/plugins/worldview-assistant
# --- benchmark (`python -m geouibench run` sets these; override only when running `deepeval test run` by hand) ---
# BENCHMARK_APP=benchmarks/worldview   # the app directory (app.py, datasets/, results/)
# BENCHMARK_AGENT=geoui                # one of the app's agent kinds — one per `deepeval test run`
# BENCHMARK_DATASET=gold               # dataset names (comma separated) or all
# BENCHMARK_RUN=2026-10-28-gold        # results folder under <app>/results/
# BENCHMARK_SMOKE=1                    # first golden of each dataset only, one extra user turn
# DEEPEVAL_RESULTS_FOLDER=benchmarks/worldview/results/<run>/deepeval
# --- manual notebook logs ---
# BENCHMARK_LOG_PATH=benchmarks/worldview_legacy/runs.jsonl
# BENCHMARK_ERROR_LOG_PATH=benchmarks/worldview_legacy/errors.jsonl
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
