# --- demo (geoui-worldview-demo) ---
OPENAI_API_KEY=
# Set automatically by demo/start.sh; override only when driving your own Chromium
PLAYWRIGHT_CDP_ENDPOINT=http://localhost:9222

# --- MCP server groups of the worldview-assistant plugin (demo/vendor/akd-plugins) ---
# Each key unlocks one group; servers whose key is unset are skipped with a warning.
# Auth for the IESO validation MCP (search_worldview_layers, validate_temporal_coverage)
VECTOR_DB_TOOL_KEY=
# FastMCP token for the shared IESO tools group (UMM-Vis lookup, Earthdata-search landing page, PDF parser)
IESO_MCP_KEY=
# FastMCP token for the Science Discovery Engine fallback search
SDE_MCP_KEY=
# FastMCP token for the EONET natural-event search
EONET_TOKEN=

# --- optional overrides ---
# WORLDVIEW_PLUGIN_DIR=/path/to/akd-plugins/plugins/worldview-assistant
# BENCHMARK_LOG_PATH=benchmarks/runs.jsonl
# BENCHMARK_ERROR_LOG_PATH=benchmarks/errors.jsonl
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
