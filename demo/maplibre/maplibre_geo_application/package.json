{
  "name": "geoui-maplibre-demo",
  "version": "0.1.0",
  "private": true,
  "description": "MapLibre + NASA GIBS map app with the @geoui/react-adapter adapter attached: an agent reads and writes its state through window.geoui",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@geoui/react-adapter": "*",
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
